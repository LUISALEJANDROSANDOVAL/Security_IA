# Dueño: los cuatro (P1, P2, P3, P4)
# Responsabilidad: plantilla de variables de entorno. Copiar a .env y completar los secretos.
# .env no se versiona. Este archivo sí. No poner claves reales aquí.
#
# Copia local (PowerShell):  Copy-Item .env.example .env
# Los parámetros que no son secretos siguen en config.yaml (HA-OPS-03).

# --- P1 — Ingress y VFS ---
HONEY_SSH_PORT=22
HONEY_HTTP_PORT=80

# --- P2 — Emulación POSIX ---
# gemini | ollama | vllm | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b-instruct-q4_K_M

# --- P3 — Tarpit y Canaries ---
# Secreto HMAC de los canary. Generar 64 hex propios; no reutilizar este texto.
CANARY_SIGNATURE_SECRET=
CANARY_ORG_PREFIX=CORP-SEC
CANARY_ALERT_WEBHOOK_URL=
TARPIT_ALPHA=0.65
TARPIT_SIGMA=0.20
TARPIT_MAX_DELAY_SECONDS=12

# --- P4 — Defensa y SOC ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_CHANNEL=honey_events
LOG_LEVEL=INFO
# IPs que el aislamiento jamás debe bloquear, separadas por coma.
HONEY_ALLOWLIST_IPS=127.0.0.1
THREAT_SCORE_THRESHOLD=80
DASHBOARD_PORT=8501

# --- Entorno ---
# production | staging | lab
HONEY_ENV=lab
HONEY_DEBUG=false
